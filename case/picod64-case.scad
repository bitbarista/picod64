// =====================================================================================
// PicoD64 case (split lid; the default since 2026-11-01, from a "Pico Case" critique). Printed parts:
//   TRAY, LID_FRONT and LID_REAR (the lid cut at the step), KNOB, 2 LED standoffs, 4 OLED pillars.
//   openscad -D 'part="lid_front"' -o stl/picod64-lid-front.stl picod64-case.scad   (etc.; case/render.sh
//   lists them all). Print every part as exported, with NO BRIM (see CASE.md). History: CASE.md.
//   The one-piece lid it replaced: archive/case-one-piece/.
//
// What changed from the one-piece case (archive/case-one-piece/picod64-case.scad), and why:
//  * Both lid parts print TOP FACE DOWN, flat on the bed: no breakaway tie, no supports, no
//    print-orientation choices. Every debossed label is on a bed face (crisp, like the tray's
//    underside name) and the top takes the bed's finish (smooth / textured PEI).
//  * Split at the step, vertical. The 45-degree slope, front-cap gussets, keels, teardrops and
//    duct/BOOT ribs only existed for printing on its back; gone.
//  * FRONT_H 13.0 -> 15.0 = OLED_H: the front is one level, so the raised OLED bezel goes
//    (the front would otherwise have two levels and not lie flat). Front 2 mm taller.
//  * Each part has its own two case screws (rear H1/H2, front H3/H4): same 4 x M2.6 x 16.
//  * Joint: the front roof runs on under the rear part's step wall (a lap: the step wall sits
//    over it, so the front roof's free edge cannot lift); tongues on the inner half of the front
//    side walls go into rebates in the rear walls; an engineered V shadow line on each side hides
//    print-to-print mismatch. The top seam is the step's inside corner.
//  * Labels tracked by a fixed 1.0 mm gap between letters (was spacing 1.1 x advance: "IEC" had
//    0.27 mm between I and E once bolded, measured); the i's dot trimmed clear of its stem.
//
// Every position comes from board_dims.scad (GENERATED from the PCB by hardware/gen/gen_case_dims.py). Case coords: x0/y0
// = outer rear-left corner... FRONT at LOW y (cy() flips KiCad y).
// =====================================================================================
include <board_dims.scad>
include <signature.scad>            // the maker's signature, GENERATED by signature.py
include <label_glyphs.scad>          // GLYPH_X etc. for LABEL_FONT, GENERATED by gen_glyphs.sh
use <knob-logo.scad>                 // logo_2d() for the knob face

/* CUSTOMISING. Everything a builder might reasonably change is in the tabs below (OpenSCAD: Window >
 * Customizer), with the defaults as printed and tested. The rest (positions, heights, openings) follows the
 * PCB and its parts and lives under [Hidden]; change the board, not those. After changing anything:
 *   bash case/export.sh     re-exports and re-runs every check (labels, logo, bodies, overhangs).
 * Printability limits (CASE.md): cut strokes >= 0.65 mm, lid left between/inside letters >= 0.9 mm. */

/* [Part] */
// What to render (STL parts print as exported, NO BRIM; both/view/exploded/section are for looking)
part = "both";            // [tray, lid_front, lid_rear, knob, knob_seater, led_standoffs, oled_pillars, badge_pwr, badge_act, badge_name, both, view, exploded, section, knob_section, labels_front, labels_rear, knob_logo]

/* [Style] */
// c64: shoulders, ribs, an OLED frame and printed badges (c64-style.scad); plain: the first case, labels cut in
STYLE = "c64";            // [c64, plain]

/* [Fit: tune for your printer] */
// Gap between the PCB and the inner walls, each side
CLR = 0.5;                // [0.2:0.05:1.0]
// Gap round the lid's lip in the tray's rebate, each face
LIP_CLR = 0.25;           // [0.1:0.05:0.5]
// Gap round the front lid part's lap and tongues in the rear part, each face
LAP_C = 0.15;             // [0.05:0.05:0.4]
// Knob grip: a spring leaf presses the shaft's flat onto a rigid flat (true), or the old plain D bore (false)
KNOB_SPRING = true;
// Spring: how far the leaf must bend, mm (more = tighter; it forgives a print +-0.15 either way)
KNOB_PRELOAD = 0.35;      // [0.15:0.05:0.6]
// Spring: leaf thickness, mm (thicker = stiffer)
KNOB_LEAF_T = 1.0;        // [0.7:0.1:1.4]
// Knob bore over the 6 mm D shaft (6.0 + this; flat 4.5 + this). Plain bore: the fit itself. Spring: the round
// side's clearance (the leaf grips), and the flat gets a tenth of it. The bore bottoms on the shaft tip
KNOB_FIT = 0.4;           // [0.0:0.05:0.6]
// Knob underside above the lid (must exceed the encoder's 0.5 push travel)
KNOB_CLR = 1.0;           // [0.6:0.1:2.0]
// Hole round the encoder bushing
SHAFT_HOLE = 7.4;         // [7.0:0.1:8.0]
// LED holes (3 mm LEDs)
LED_HOLE = 3.2;           // [2.8:0.1:4.0]
// BOOTSEL pinhole (press with a paperclip)
BS_BORE = 1.4;            // [1.0:0.1:2.0]

/* [Screws] */
// selftap: M2.6 x 16 countersunk self-tappers into the lid. insert: M3 heat-set inserts
FIXING = "selftap";       // [selftap, insert]
// Screw length (checked against the hole depth)
SCREW_L = 16;             // [12:1:20]
// Clearance hole through the tray
SCREW_D = 3.4;            // [2.8:0.1:3.6]
// Countersink diameter at the tray's underside
HEAD_D = 6.6;             // [5.0:0.1:7.0]
// Pilot hole for self-tappers
SELFTAP_D = 2.1;          // [1.8:0.1:2.6]
SELFTAP_DEPTH = 10.5;     // [6:0.5:12]
// Hole for heat-set inserts (as the insert maker specifies)
INSERT_HOLE_D = 4.0;      // [3.5:0.1:5.0]
INSERT_DEPTH = 9.0;       // [5:0.5:12]
// Stick-on feet go over the screws: a 0.4 mm hoop marks where (diameter)
FOOT_D = 10.6;            // [8:0.2:12]

/* [Shell] */
// Side walls
WALL = 2.4;               // [1.8:0.1:3.2]
// Tray floor
FLOOR = 2.0;              // [1.6:0.2:3.0]
// Lid roof (labels are cut into it)
ROOF = 2.0;               // [1.6:0.2:3.0]

/* [Labels] */
// Labels on the lid top (IEC, name, PWR/ACT, BOOTSEL symbol)
LABELS = true;
// "USB" on the rear wall
USB_LABEL = true;
// The micro-USB plug's moulding is centred on the Pico's socket, so the room above and below the socket's centre
// must match: the tray's recess takes it USB_PLUG_DOWN below the split plane (AUDIT D1), and the lid's cutout ends as
// far above the socket's centre (it reached USB_TOP_Z + 4.5 = 8.2 mm until 2026-11-12: 1 mm more than any plug the
// tray takes, a visible gap over a slim one). Plugs up to ~9.7 mm tall fit.
USB_SOCK_H = 2.7;          // [A] the Pico 2's micro-USB receptacle, its top at USB_TOP_Z
USB_SOCK_W = 7.5;          // [A] and its width
USB_PLUG_DOWN = 2.5;       // the tray's recess below the split plane
USB_OPEN_TOP = 2 * (USB_TOP_Z - USB_SOCK_H / 2) + USB_PLUG_DOWN;   // 7.18 above the board
// Name on the lid, between the IEC sockets (also on the tray underside)
// "Developed by" and a signature, engraved inside the front lid's roof (seen when it's off)
MAKER_MARK = true;
MAKER_DEPTH = 0.4;        // [0.2:0.1:0.8]
NAME = "PicoD64";
NAME_SIZE = 6.0;          // [4:0.2:9]
// Name debossed on the tray's underside
TRAY_NAME = true;
// Small labels; at 4.2 the B's islands are 0.94 mm, the smallest that prints
LABEL_SIZE = 4.2;         // [3.5:0.1:6]
// Cut depth
LABEL_DEEP_CUT = 0.8;     // [0.4:0.1:1.2]
// Font: must be installed; then run gen_glyphs.sh "<font>" and check_labels.sh
LABEL_FONT = "Eurostile";

/* [Knob] */
KNOB_D = 18;              // [14:1:24]
KNOB_H = 14;              // [10:1:20]
// Ribs round the knob (0: smooth)
KNURLS = 24;              // [0:1:40]
// Logo on the face: D = 5.25" disk (knob-logo.scad)
KNOB_LOGO = "D";          // [D, none]

/* [OLED module and pillars] */
// No screws: four printed pillars slide onto the module's side edges (a groove takes the PCB), then the module goes
// down onto J4 and the pillars' pegs snap into the board's holes H5-H8. Works for any module's hole pattern.
// Back of the module's PCB to the top of the glass, at the thickest place (sets the height: see BUILD-NOTES, OLED)
OLED_THICK = 2.88;        // [2.0:0.02:4.0]
// The module's PCB: thickness (the groove takes up to OLED_SLOT) and width across the header's direction
OLED_PCB_T = 1.13;        // [0.8:0.01:1.6]
OLED_MOD_W = 35.55;       // [34.5:0.05:36.5]
// Header: its plastic under the module's PCB, and the pin below that plastic
OLED_HDR_PLASTIC = 2.58;  // [1.5:0.02:3.5]
OLED_HDR_PIN = 5.93;      // [3:0.05:8]
// Top of the glass this far under the lid's roof
OLED_GLASS_GAP = 0.45;    // [0.2:0.05:1.5]
// Pillar fit (printer-dependent): peg in the board's 2.7 mm hole, its barb, the groove for the module's PCB
PEG_D = 2.55;             // [2.3:0.05:2.7]
BARB_D = 2.95;            // [2.75:0.05:3.3]
OLED_SLOT = 1.35;         // [1.0:0.05:2.0]
// Clearance from the module's side edge to the groove's bottom
GROOVE_CLR = 0.3;         // [0.1:0.05:0.8]
PILLAR_AF = 4.4;          // [3.8:0.1:5.4]

/* [Two-colour inlay] */
// Letters print as a separate part in a second colour, filling cuts INLAY_D deep (needs an AMS; CASE.md)
INLAY = false;
INLAY_D = 0.4;            // [0.2:0.2:0.8]

/* [Preview colours] */
// As printed (2026-11-05): both lids and the badges light, the badges' letters, tray and knob dark
LID_COLOUR = "#AC937D";
LID_REAR_COLOUR = "#AC937D";
BADGE_COLOUR = "#AC937D";
BADGE_INK = "#876A56";
TRAY_COLOUR = "#876A56";
KNOB_COLOUR = "#876A56";
// Show the labels dark in "view"
LABEL_OVERLAY = true;

/* [Hidden] */

/* ---- the shell ---- */
STANDOFF = 5.0; EPS = 0.01;
PCB_BOT = FLOOR + STANDOFF;
PCB_TOP = PCB_BOT + BOARD_T;          // the tray/lid split plane
OLED_H = 15.0;            // glass top 14.3, up to 14.5 above our PCB [D: module spec]; see case/
FRONT_H = OLED_H;         // one front level (was 13.0 with a raised OLED bezel)
REAR_H = 22.6;            // IEC socket 21.4 + 1.2
STEP_Y = 20.0;            // board y of the step's inner face: IEC bodies end at 18.72 (board y 20-32: nothing over ~11)
IN_W = BOARD_W + 2 * CLR; IN_L = BOARD_L + 2 * CLR;
OUT_W = IN_W + 2 * WALL;  OUT_L = IN_L + 2 * WALL;
R_OUT = BOARD_R + CLR + WALL;
function cx(x) = WALL + CLR + x;
function cy(y) = WALL + CLR + (BOARD_L - y);
YS = cy(STEP_Y) - WALL;   // case y of the split = the step's outer face
FRONT_TOP = PCB_TOP + FRONT_H + ROOF;
REAR_TOP = PCB_TOP + REAR_H + ROOF;

/* ---- the front/rear joint ---- */
LAP_T = 1.0;              // side-wall tongue: inner 1.0 of the 2.4 wall
LAP_L = 4.0;              // ... reaching this far into the rear part (> WALL, so it overlaps the roof lap)
SHADOW = 0.8;             // V shadow line at the side seams: 1.13 wide, 0.57 deep

module rounded_box(w, l, h, r) {
    hull() for (x = [r, w - r], y = [r, l - r]) translate([x, y, 0]) cylinder(r = r, h = h, $fn = 48);
}

/* ---- fastening (as case/) ---- */
INSERT_D = FIXING == "insert" ? INSERT_HOLE_D : SELFTAP_D;
INSERT_H = FIXING == "insert" ? INSERT_DEPTH : SELFTAP_DEPTH;
FOOT_RECESS_D = FOOT_D; FOOT_RECESS_H = 0;
FOOT_MARK_W = 0.6; FOOT_MARK_H = 0.4;
POST_D = 7.0;

/* ---- user features ---- */
LABEL_STRETCH = 1.35;
LABEL_GAP = 1.0;          // tracking by GAP, not by advance: every pair of bolded glyphs is set exactly this far apart
                          // (box to box). Was spacing = 1.1 x advance: IEC's I-E came out 0.27 mm (measured), PWR's
                          // P-W 0.10; scaling the advance up enough for I-E left "P W  R" visibly uneven (render)
                          // LABEL_SIZE: the cut letters leave ISLANDS of lid standing alone on the first layer (B's two holes, the
                          // 4's triangle, A, P, R, o, D, 6). Islands >= 0.9 (two Classic lines, as any plastic here);
                          // slots >= 0.65 (IEC's 0.64-0.70 printed clean). B decides: island 0.94 at 4.2 / bold 0.2.
                          // (Was 5.2 for a 1.2 island limit read off a print that Orca's auto brim had spoiled:
                          // it rings each island, inside the letter. PRINT THE LIDS WITH NO BRIM.)
LABEL_BOLD = 0.2;         // outline grown each side (it also shrinks the islands, 2 x this)
                          // CAP, I_STEM: label_glyphs.scad. Once bolded, the i's dot is 0.27 above the stem and would print as
I_DOT_GAP = 0.9;          // one slot: trim the dot's underside to leave this (0.9: two lines, so Classic walls fill it too)
// glyph ink extents (GLYPH_X) come from label_glyphs.scad: tracking is by gap, so it needs them per glyph
assert(GLYPH_FONT == LABEL_FONT, str("label_glyphs.scad is for ", GLYPH_FONT, ": run  bash case/gen_glyphs.sh \"", LABEL_FONT, "\""));
OLED_WIN_W = 31.0; OLED_WIN_D = 18.0;
OLED_WIN_DY = 2.0 + 12.8 - OLED_D / 2;
OLED_GLASS_END = 2.0 + 28.2;
OLED_M = 0.5;
DUCT_ID = 9.0; BZ_TOP = 6.6;
LED_LENS = 5.4; LED_PROUD = 1.5;
LED_STANDOFF = FRONT_H + ROOF + LED_PROUD - LED_LENS;   // 13.1 (was 11.1); leads needed ~16 mm, >= 25 typ. [C]
/* OLED pillars (2026-11-02: no screws; "expecting a user to have a vast selection of fixings" is a pet
 * peeve). Modules differ (AUDIT D7: holes 30.15-31.5 apart, edges 2.50-2.58 out from H5-H8, 2.8-3.3 thick), so
 * the pillars don't use the module's holes: a groove in each pillar's head takes the module's PCB edge,
 * slid on before the module goes down; the pegs then snap into H5-H8 and the module is captured. */
OLED_PILLAR_H = FRONT_H - OLED_GLASS_GAP - OLED_THICK;   // board top to the module's underside (11.67)
J4_H = 8.5;                                             // the 4-pin socket's height [D]
OLED_EDGE = OLED_MOD_W / 2 - abs(OLED_HOLES[0][0] - OLED_HDR[0]);   // module side edge, out from the hole axis
GROOVE_X = OLED_EDGE + GROOVE_CLR;                      // the groove's bottom, out from the axis
JAW_IN = 1.6;                                           // the upper jaw reaches in to here: over the PCB by ~1
JAW_T = 1.2; SPINE = 1.2;                               // jaw thickness, the wall behind the groove
assert(OLED_PCB_T + 0.1 <= OLED_SLOT, "the module's PCB is too thick for OLED_SLOT");
assert(OLED_EDGE - JAW_IN >= 0.6, "the jaw would hardly overlap the module's PCB (OLED_MOD_W too small?)");
assert(OLED_PILLAR_H + OLED_SLOT + JAW_T <= FRONT_H - 0.3, "the pillar's jaw would reach the lid's roof");
assert(OLED_HDR_PIN - (OLED_PILLAR_H - OLED_HDR_PLASTIC - J4_H) >= 3.0, "the module's header pins would hardly be in J4");
assert(OLED_PILLAR_H >= J4_H + OLED_HDR_PLASTIC - 0.05, "the pillars are shorter than the header seated in J4");
assert(PEG_D < OLED_BOARD_HOLE_D && BARB_D > OLED_BOARD_HOLE_D, "PEG_D must pass the board's hole and BARB_D grip under it");

/* ---- tray/lid locating joint (as case/, R20), now along the front wall too: the reason it
 * stopped short there (the front cap's free edge, printed on its back) is gone ---- */
LIP_T = 1.0; LIP_H = 2.0;
module lip_ring(t, h, z0 = PCB_TOP - EPS)
    translate([0, 0, z0]) difference() {
        translate([WALL - t, WALL - t, 0]) rounded_box(IN_W + 2 * t, IN_L + 2 * t, h + EPS, BOARD_R + CLR + t);
        translate([WALL, WALL, -EPS]) rounded_box(IN_W, IN_L, h + 3 * EPS, BOARD_R + CLR);
    }
module lip_gaps() {
    translate([cx(IEC_X[0]) - IEC_BODY_W / 2 - 1.5, OUT_L - WALL - 2, 0])
        cube([cx(IEC_X[1]) - cx(IEC_X[0]) + IEC_BODY_W + 3.0, WALL + 3, 100]);
    translate([cx(USB_X) - 7.5, OUT_L - WALL - 2, 0]) cube([15.0, WALL + 3, 100]);
    translate([cx(SD_CARD_X) - 8.5, -1, 0]) cube([17.0, WALL + 3, 100]);
}

/* ===================================================================================== */
module tray() {
    difference() {
        union() {
            difference() {
                rounded_box(OUT_W, OUT_L, PCB_TOP, R_OUT);
                translate([WALL, WALL, FLOOR]) rounded_box(IN_W, IN_L, PCB_TOP, BOARD_R + CLR);
            }
            for (h = HOLES) translate([cx(h[0]), cy(h[1]), 0]) cylinder(d = POST_D, h = PCB_BOT, $fn = 32);
            // a post under the encoder: pressing the knob loads the case, not the PCB
            translate([cx(SHAFT_X), cy(SHAFT_Y), 0]) cylinder(d = 5, h = PCB_BOT, $fn = 32);   // under the shaft: no pads there
        }
        // the feet stick on over the screws (2026-10-30: common practice; the old recesses
        // inside the screws overlapped the countersinks by ~1 mm). Each recess is centred on its
        // screw; the countersink starts at the recess floor, so the head sits under the foot.
        // Tightest corner: screw 6.4 from both edges -> 1.1 mm of tray outside the Ø10.6 recess.
        for (h = HOLES) translate([cx(h[0]), cy(h[1]), -EPS]) {
            difference() {                            /* a 0.4 mm hoop where the foot goes: no recess to bridge */
                cylinder(d = FOOT_RECESS_D, h = FOOT_MARK_H + EPS, $fn = 48);
                translate([0, 0, -EPS]) cylinder(d = FOOT_RECESS_D - 2 * FOOT_MARK_W, h = FOOT_MARK_H + 3 * EPS, $fn = 48);
            }
            cylinder(d = SCREW_D, h = PCB_BOT + 1, $fn = 24);
            translate([0, 0, FOOT_RECESS_H])
                cylinder(d1 = HEAD_D, d2 = SCREW_D, h = (HEAD_D - SCREW_D) / 2, $fn = 32);   // countersink
        }
        // the rebate the lid's lip locates in (its top LIP_H + LIP_CLR of the wall's inner side)
        difference() { lip_ring(LIP_T + LIP_CLR, LIP_H + LIP_CLR + 1, PCB_TOP - LIP_H - LIP_CLR); lip_gaps(); }
        // micro-USB plug moulding: it reaches ~1.2 mm below the split plane where it enters the
        // wall (socket face 1.3 mm into the wall) [A: plug sizes vary]; the lid notch alone left
        // the tray wall in its way (AUDIT D1)
        translate([cx(USB_X) - 6.0, cy(USB_FACE_Y) - 0.3, PCB_TOP - USB_PLUG_DOWN]) cube([12.0, OUT_L - cy(USB_FACE_Y) + 0.3 + 1, USB_PLUG_DOWN + EPS]);
        sd_scoop();   // its lower half (AUDIT D14)
        // debossed name on the underside, mirrored to read from below
        if (TRAY_NAME) translate([OUT_W / 2, OUT_L / 2, -EPS]) linear_extrude(0.6) mirror([1, 0, 0])
            text(NAME, size = 7, halign = "center", valign = "center");
    }
}

// microSD finger scoop: 14 wide x 6 high x 1.5 deep, centred on the card, so it straddles the split
// plane and both tray and lid cut it (AUDIT D14)
module sd_scoop() translate([cx(SD_CARD_X), 0, PCB_TOP + 0.9]) scale([7.0, 1.5, 3.0]) sphere(r = 1, $fn = 64);

/* ===================================================================================== */
// The whole lid as one solid (both parts together); lid_front()/lid_rear() cut it.
module lid_body() {
    rounded_box(OUT_W, OUT_L, FRONT_TOP, R_OUT);
    intersection() {   // tall rear: rounded at the back, square at the step
        rounded_box(OUT_W, OUT_L, REAR_TOP, R_OUT);
        translate([-1, YS, -1]) cube([OUT_W + 2, OUT_L, 100]);
    }
}
module lid_cavity() {
    translate([WALL, WALL, -EPS]) rounded_box(IN_W, IN_L, PCB_TOP + FRONT_H + EPS, BOARD_R + CLR);
    intersection() {
        translate([WALL, WALL, -EPS]) rounded_box(IN_W, IN_L, PCB_TOP + REAR_H + EPS, BOARD_R + CLR);
        translate([-1, cy(STEP_Y), -1]) cube([OUT_W + 2, OUT_L, 100]);
    }
}
// a screw post from the PCB's top face to the roof, merged into the nearest side wall
module post(h) {
    px = cx(h[0]); py = cy(h[1]); xw = h[0] < BOARD_W / 2 ? WALL : OUT_W - WALL;
    top = h[1] < STEP_Y ? REAR_H : FRONT_H;
    translate([0, 0, PCB_TOP]) linear_extrude(top + EPS) hull() {
        translate([px, py]) circle(d = POST_D, $fn = 32);
        translate([xw - sign(px - xw) * 0.5, py]) square([1, POST_D], center = true);
    }
}

module lid_solid() {
    difference() {
        union() {
            difference() { lid_body(); lid_cavity(); translate([-1, -1, -1]) cube([OUT_W + 2, OUT_L + 2, PCB_TOP + 1]); }
            difference() { lip_ring(LIP_T, LIP_H + EPS, PCB_TOP - LIP_H); lip_gaps(); }
            intersection() { lid_body(); for (h = HOLES) post(h); }
            // rib behind the post between the IEC notches (AUDIT D15), hung from the roof
            translate([cx((IEC_X[0] + IEC_X[1]) / 2) - (IEC_X[1] - IEC_X[0] - IEC_BODY_W - 0.6) / 2, cy(9), PCB_TOP + 0.2])
                cube([IEC_X[1] - IEC_X[0] - IEC_BODY_W - 0.6, OUT_L - WALL / 2 - cy(9), REAR_H - 0.2 + EPS]);
            // piezo sound duct, roof down to 0.5 above BZ1 (AUDIT D13); plain tube now
            translate([cx(BUZZER[0]), cy(BUZZER[1]), PCB_TOP + BZ_TOP + 0.5])
                cylinder(d = DUCT_ID + 2.4, h = REAR_H - BZ_TOP - 0.5 + EPS, $fn = 48);
            // BOOTSEL tube, stopping 1 mm above the plunger
            translate([cx(BOOTSEL_X), cy(BOOTSEL_Y), PCB_TOP + BOOTSEL_TOP_Z + 1.1])
                cylinder(d = BS_BORE + 1.6, h = REAR_H - BOOTSEL_TOP_Z - 1.1 + EPS, $fn = 24);
        }
        // ---- openings, each a notch from the lid's lower edge (as case/) ----
        for (x = IEC_X) translate([cx(x) - IEC_BODY_W / 2 - 0.3, OUT_L - WALL - 1, PCB_TOP - EPS])
            cube([IEC_BODY_W + 0.6, WALL + 2, IEC_BODY_H + 0.3]);
        // USB: as the tray's relief, the plug's moulding only gets a pocket from the socket's face outward (the outer
        // 1.1 mm of the wall); behind it the wall keeps just a hole for the socket itself, which fills it. (Until
        // 2026-11-12 the moulding's 12 mm cut ran through the whole wall: a window into the case.)
        translate([cx(USB_X) - 6.0, cy(USB_FACE_Y) - 0.3, PCB_TOP - EPS]) cube([12.0, OUT_L - cy(USB_FACE_Y) + 0.3 + 1, USB_OPEN_TOP]);
        translate([cx(USB_X) - USB_SOCK_W / 2 - 0.4, OUT_L - WALL - 1, PCB_TOP - EPS]) cube([USB_SOCK_W + 0.8, WALL + 2, USB_TOP_Z + 0.4]);
        translate([cx(SD_CARD_X) - 6.0, -1, PCB_TOP - EPS]) cube([12.0, WALL + 2, 1.8]);
        sd_scoop();
        // OLED window, chamfered outward (as case/; it now starts at the one front roof)
        translate([cx(OLED_X0 + OLED_W / 2), cy(OLED_Y0 + OLED_D / 2 + OLED_WIN_DY), PCB_TOP + OLED_H - EPS])
            hull() {
                cube([OLED_WIN_W, OLED_WIN_D, EPS], center = true);
                translate([0, -(ROOF - 0.5) / 2, ROOF + 2 * EPS])
                    cube([OLED_WIN_W + 2 * ROOF, OLED_WIN_D + ROOF + 0.5, EPS], center = true);
            }
        translate([cx(BUZZER[0]), cy(BUZZER[1]), PCB_TOP + BZ_TOP + 0.5 - EPS]) cylinder(d = DUCT_ID, h = REAR_H - BZ_TOP, $fn = 48);
        for (a = [0 : 60 : 359]) translate([cx(BUZZER[0]) + 3.5 * cos(a), cy(BUZZER[1]) + 3.5 * sin(a), PCB_TOP + REAR_H - EPS])
            cylinder(d = 2.0, h = ROOF + 2 * EPS, $fn = 20);
        translate([cx(BUZZER[0]), cy(BUZZER[1]), PCB_TOP + REAR_H - EPS]) cylinder(d = 2.0, h = ROOF + 2 * EPS, $fn = 20);
        translate([cx(SHAFT_X), cy(SHAFT_Y), PCB_TOP]) cylinder(d = SHAFT_HOLE, h = 40, $fn = 48);
        translate([cx(SHAFT_X), cy(SHAFT_Y), PCB_TOP + FRONT_H - EPS])      // 45-degree countersink for the knob's nose
            cylinder(r1 = SHAFT_HOLE / 2, r2 = CSK_R + EPS, h = ROOF + 2 * EPS, $fn = 48);
        for (p = [LED_PWR, LED_ACT]) translate([cx(p[0]), cy(p[1]), PCB_TOP + FRONT_H - EPS]) cylinder(d = LED_HOLE, h = 40, $fn = 32);
        translate([cx(BOOTSEL_X), cy(BOOTSEL_Y), PCB_TOP + BOOTSEL_TOP_Z]) cylinder(d = BS_BORE, h = 40, $fn = 24);
        translate([cx(BOOTSEL_X), cy(BOOTSEL_Y), REAR_TOP - 1.0]) cylinder(d1 = BS_BORE, d2 = BS_BORE + 2.0, h = 1.0 + EPS, $fn = 24);
        for (h = HOLES) translate([cx(h[0]), cy(h[1]), PCB_TOP - EPS]) cylinder(d = INSERT_D, h = INSERT_H, $fn = 24);
        lid_labels();
        if (MAKER_MARK) maker_mark();
        // V shadow line where the parts meet on each side wall (up to the front roof; above it is the step's corner)
        for (x = [0, OUT_W]) translate([x, YS - SHADOW / sqrt(2), PCB_TOP - LIP_H - 1]) rotate([0, 0, 45])
            cube([SHADOW, SHADOW, FRONT_TOP - PCB_TOP + LIP_H + 1]);
    }
}

// "Developed by" and the signature, engraved up into the front roof's underside, mirrored so they read from
// inside with the front edge nearest. The strip in front of the knob and the OLED window (y 4-17) is clear
// on both faces; the roof keeps 1.6 of its 2.0 there. Text 3 high, bolded so its strokes print
MAKER_TEXT = "Developed by"; MAKER_TEXT_SIZE = 3.0; MAKER_BASE_Y = 6.5; MAKER_GAP = 3.0;
module maker_mark() {
    tw = 22.3;                                   // MAKER_TEXT's width at this size in Eurostile, bolded (measured)
    u0 = (OUT_W - (tw + MAKER_GAP + SIG_W)) / 2; // the pair centred across the lid
    translate([OUT_W, 0, PCB_TOP + FRONT_H - EPS]) mirror([1, 0, 0]) linear_extrude(MAKER_DEPTH + EPS) {
        translate([u0, MAKER_BASE_Y]) offset(r = 0.12) text(MAKER_TEXT, size = MAKER_TEXT_SIZE, font = LABEL_FONT, $fn = 16);
        translate([u0 + tw + MAKER_GAP, MAKER_BASE_Y]) signature_2d();
    }
}

// what the FRONT part keeps beyond the split plane: the roof lap under the step wall, and the side
// tongues. g grows it (the rear part's clearance cut)
module front_keep(g = 0) {
    translate([WALL - LAP_T - g, YS - 1, PCB_TOP + FRONT_H - g]) cube([IN_W + 2 * (LAP_T + g), cy(STEP_Y) - YS + 1 + g, ROOF + 2 * g]);
    for (x = [WALL - LAP_T - g, OUT_W - WALL - g]) translate([x, YS - 1, PCB_TOP - LIP_H - 1])
        cube([LAP_T + 2 * g, LAP_L + 1 + g, FRONT_H + ROOF + LIP_H + 1 + g]);
}
module front_side() translate([-1, -1, -1]) cube([OUT_W + 2, YS + 1, FRONT_TOP + 1]);   // (not to 100: a zero-thickness sliver of the step face at y = YS)
module rear_side() translate([-1, YS, -1]) cube([OUT_W + 2, OUT_L, 100]);

module lid_front_plain() intersection() { lid_solid(); union() { front_side(); front_keep(); } }
module lid_rear_plain() difference() { intersection() { lid_solid(); rear_side(); } front_keep(LAP_C); }
module lid_front() if (STYLE == "c64") difference() { lid_front_plain(); c64_front_cuts(); } else lid_front_plain();
module lid_rear() if (STYLE == "c64") difference() { lid_rear_plain(); c64_rear_cuts(); } else lid_rear_plain();
include <c64-style.scad>

// labels, cut LABEL_DEEP into the bed faces, set glyph by glyph LABEL_GAP apart
function gx(c) = c == " " ? [" ", 0, SPACE_W] : let(k = search([c], GLYPH_X)[0])
    assert(is_num(k), str("no glyph metrics for '", c, "' (label_glyphs.scad covers ASCII 33-126)")) GLYPH_X[k];
SPACE_W = 0.25;           // a space in a label: this x size, plus the gaps either side
function vsum(v, k) = k <= 0 ? 0 : v[k - 1] + vsum(v, k - 1);
module label_2d(t, s, h = "center", gap = LABEL_GAP, bold = LABEL_BOLD) {   // gap/bold: for test-tokens.scad
    n = len(t);
    ws = [for (c = t) (gx(c)[2] - gx(c)[1]) * s * LABEL_STRETCH];
    step = gap + 2 * bold;
    W = vsum(ws, n) + (n - 1) * step;
    translate([h == "center" ? -W / 2 : 0, -CAP * s / 2]) for (k = [0 : n - 1]) translate([vsum(ws, k) + k * step, 0])
        difference() {
            offset(r = bold) scale([LABEL_STRETCH, 1]) translate([-gx(t[k])[1] * s, 0])
                text(t[k], size = s, font = LABEL_FONT, halign = "left");
            if (t[k] == "i") translate([-1, I_STEM * s + bold]) square([ws[k] + 2, I_DOT_GAP]);
        }
}
function label_w(t, s, gap = LABEL_GAP, bold = LABEL_BOLD) =   // label_2d's width, bolding included
    vsum([for (c = t) (gx(c)[2] - gx(c)[1]) * s * LABEL_STRETCH], len(t)) + (len(t) - 1) * (gap + 2 * bold) + 2 * bold;
module name_2d() label_2d(NAME, NAME_SIZE);
/* BOOTSEL: a secondary function, so a symbol, not a word (2026-11-01: "BOOT" was too prominent). IEC 60417
 * has no bootloader/firmware symbol; this is the common "download" glyph, an arrow onto a bar (load firmware).
 * Top at y 0. Cut 0.8 strokes (>= 0.65 slot), 0.9 of lid between arrow tip and bar (two Classic lines), no islands. */
module boot_sym_2d() {
    translate([-0.4, -1.4]) square([0.8, 1.4 + EPS]);                  // shaft
    polygon([[-1.3, -1.2], [1.3, -1.2], [0, -2.5]]);                    // head
    translate([-1.6, -2.5 - 0.9 - 0.8]) square([3.2, 0.8]);             // bar
}
/* Label cut: straight-sided, LABEL_DEEP into the face (square-bottomed casts the most shadow).
 * 2026-11-01, the slicer preview: the strand along every stroke on the 0.8 print was BRIM. Orca's auto brim
 * rings every small separate first-layer piece, and the islands inside o D 6 4 B P R A are exactly that, so it
 * laid brim inside the cuts. Print the lids with no brim (they need none). It was never sag: a 45 deg V was
 * tried twice for that and removed. */
// INLAY (2026-11-01): the letters print as their own part in a second colour, filling cuts INLAY_D deep
// (2 layers of 0.2) flush with the face; parts *_inlay + labels_*
LABEL_DEEP = INLAY ? INLAY_D : LABEL_DEEP_CUT;
module vcut(d = LABEL_DEEP) translate([0, 0, -d]) linear_extrude(d + 0.4) children();   // z 0 = the face
LED_LABEL_SPREAD = 0.0;   // PWR/ACT on their LEDs (6.0 pitch): 4.4 tall rows leave ~1.6 mm of lid between
module lid_labels(top = true, wall = true) {   // wall: USB, on the rear wall (never inlaid: a colour change every layer)
    if (top && LABELS) {
    if (STYLE != "c64") {   // c64: printed badges instead (c64-style.scad)
    translate([cx(LED_PWR[0]) + 3.0, cy(LED_PWR[1]) + LED_LABEL_SPREAD, FRONT_TOP]) vcut() label_2d("PWR", LABEL_SIZE, "left");
    translate([cx(LED_ACT[0]) + 3.0, cy(LED_ACT[1]) - LED_LABEL_SPREAD, FRONT_TOP]) vcut() label_2d("ACT", LABEL_SIZE, "left");
    }
    translate([cx(BOOTSEL_X), cy(BOOTSEL_Y) - BS_BORE / 2 - 1.0 - 1.0, REAR_TOP]) vcut() boot_sym_2d();   // 1.0 below the countersink
    if (STYLE != "c64") translate([cx((IEC_X[0] + IEC_X[1]) / 2), cy(STEP_Y) + 7.0, REAR_TOP]) vcut() name_2d();
    for (x = IEC_X) translate([cx(x), cy(3.5), REAR_TOP]) vcut() label_2d("IEC", LABEL_SIZE);
    }
    if (wall && USB_LABEL) translate([cx(USB_X), OUT_L, PCB_TOP + USB_OPEN_TOP + 3.8]) rotate([90, 0, 180])   // local +z = outward
        vcut(LABEL_DEEP_CUT) label_2d("USB", LABEL_SIZE);                                      // into the 2.4 wall, either way
}

/* ===================================================================================== */
// Knob for the EC11's 6 mm D shaft (flat at 4.5), 18 mm, knurled. Alps EC11E15244G1 [D: Alps EC11E
// Drawing No.2]: tip 24.5 above the PCB, D-flat from 14.5; push travel 0.5. The front roof top is now
// 17.0 (was 15.0), which left only 6.5 mm of shaft in the knob (2026-11-01). So:
//  (1) the bore BOTTOMS on the shaft tip: the knob's height is set by the shaft, KNOB_CLR above the lid,
//      not by how hard it was pushed on (it was a friction fit in a 9 mm bore with 8.5 engaged);
//  (2) a 45-degree nose under the knob drops into a matching countersink in the lid (a raised collar on
//      the lid would stop the front printing flat). The nose follows the countersink KNOB_CLR higher, so
//      the clearance stays KNOB_CLR all the way round; it stops where its wall round the bore is KNOB_WALL.
// Engaged: SHAFT_TIP - (FRONT_H + ROOF + KNOB_CLR) + NOSE_H = 24.5 - 18.0 + 1.6 = 8.1 mm, all D-flat.
SHAFT_TIP = 24.5; SHAFT_FLAT_FROM = 14.5;
SHAFT_D = 6.0; SHAFT_FLAT = 4.5;
KNOB_WALL = 1.0; KNOB_BORE = SHAFT_D + KNOB_FIT;
CSK_R = SHAFT_HOLE / 2 + ROOF;                         // lid countersink radius at the top face (5.7)
NOSE_H = CSK_R - (KNOB_BORE / 2 + KNOB_WALL);          // 1.6
KNOB_ENGAGE = SHAFT_TIP - (FRONT_H + ROOF + KNOB_CLR) + NOSE_H;
assert(SHAFT_TIP - KNOB_ENGAGE >= SHAFT_FLAT_FROM, "knob bore reaches below the D-flat");
assert(KNOB_CLR > 0.5, "knob clearance must exceed the 0.5 push travel");
// The spring grip (KNOB_SPRING, 2026-11-08: the first knobs were too loose at FIT 0.2 and too tight below it: a plain
// bore's grip IS its print error). The flat stays rigid, a whisker over the shaft's, so turning has no backlash; the
// round side is KNOB_FIT loose; opposite the flat a cantilever leaf, free of the body by two slots and a gap behind,
// rooted at the bore's blind end, leans in to KNOB_PRELOAD of interference near the nose and presses the shaft's flat
// onto the rigid one. Its grip is a bend, not a squeeze: F = 3EI.d/L^3 (1.0 x 3.6, 6.5 long), ~4 N in PLA (2.3 in
// PETG) at 0.35, and a print +-0.15 out still grips (2-6 N) and never binds. The leaf and its pocket start above the
// nose (narrower than the body: the pocket broke out through it); the nose keeps the loose D. Printed nose up, the
// leaf is a vertical wall on its root.
LEAF_W = 3.6; LEAF_SLOT = 0.6; LEAF_GAP = 0.6;           // leaf width; the slots each side; the gap behind it at the root
KNOB_FLAT_CLR = KNOB_FIT / 10;
module knob_bore_plain() {   // the D: round KNOB_BORE, flat at SHAFT_FLAT + fit
    intersection() {
        cylinder(d = KNOB_BORE, h = KNOB_ENGAGE + EPS, $fn = 32);
        translate([-KNOB_BORE / 2, -KNOB_BORE / 2 + (KNOB_BORE - (SHAFT_FLAT + (KNOB_SPRING ? KNOB_FLAT_CLR : KNOB_FIT))), 0])
            cube([KNOB_BORE, KNOB_BORE, KNOB_ENGAGE + EPS]);
    }
}
// in the bore's frame: z 0 the open end, KNOB_ENGAGE the blind end; the flat is on -y (knob_bore_plain), the leaf on +y
LEAF_IN_ROOT = KNOB_BORE / 2 + 0.1;              // the leaf's face at the root: clear of the shaft (and off the bore's faces)
LEAF_IN_GRIP = SHAFT_D / 2 - KNOB_PRELOAD;       // near the nose: the interference
LEAF_LEAD = 1.0;                                 // the lead-in at the leaf's free end
LEAF_Z0 = NOSE_H + 0.2;                          // the leaf's free end: above the nose
LEAF_BACK = LEAF_IN_ROOT + KNOB_LEAF_T + LEAF_GAP;   // the pocket's back wall
assert(LEAF_BACK - (LEAF_IN_GRIP + KNOB_LEAF_T) > KNOB_PRELOAD + 0.2, "knob leaf: no room behind it to bend");
assert(KNOB_D / 2 - LEAF_BACK >= 2.0, "knob leaf: the wall behind it is too thin");
module knob_leaf_pocket() {
    translate([-(LEAF_W / 2 + LEAF_SLOT), -LEAF_BACK, LEAF_Z0]) cube([LEAF_W + 2 * LEAF_SLOT, LEAF_BACK - 1.5, KNOB_ENGAGE - LEAF_Z0 + EPS]);
}
module knob_leaf() {   // hull of three slabs: the root, the grip, the mouth
    module slab(z, yin) translate([-LEAF_W / 2, -yin - KNOB_LEAF_T, z]) cube([LEAF_W, KNOB_LEAF_T, EPS]);
    hull() { slab(KNOB_ENGAGE + 0.3, LEAF_IN_ROOT); slab(LEAF_Z0 + LEAF_LEAD, LEAF_IN_GRIP); slab(LEAF_Z0, LEAF_IN_ROOT); }   // root 0.3 into the solid
}
module knob() {   // as fitted: z 0 = the body's underside, the nose below it
    difference() {
        union() {
            cylinder(d = KNOB_D, h = KNOB_H, $fn = 72);
            if (KNURLS > 0) for (i = [0 : KNURLS - 1]) rotate([0, 0, i * 360 / KNURLS]) translate([KNOB_D / 2, 0, 0]) cylinder(d = 1.6, h = KNOB_H, $fn = 12);
            translate([0, 0, -NOSE_H]) cylinder(r1 = CSK_R - NOSE_H, r2 = CSK_R, h = NOSE_H + EPS, $fn = 72);
        }
        translate([0, 0, -NOSE_H - EPS]) {      // blind: its end sits on the shaft tip
            knob_bore_plain();
            if (KNOB_SPRING) mirror([0, 1, 0]) knob_leaf_pocket();
        }
        if (KNOB_LOGO != "none") translate([0, 0, KNOB_H]) vcut() logo_2d(KNOB_LOGO);   // 5.25" disk logo (knob-logo.scad, D; check_logo.py), top to the back
    }
    if (KNOB_SPRING) translate([0, 0, -NOSE_H - EPS]) mirror([0, 1, 0]) knob_leaf();
}

// Knob seating tool (2026-11-15): the knob's first push onto a shaft breaks the spring leaf free of the fine bridges a
// print can leave in its slots, and that takes a firm push: better on the bench than on the encoder. A dummy of the
// EC11's shaft (SHAFT_D round, flat at SHAFT_FLAT: the same numbers the bore is made from) stands on a base that sits
// on the bench; the knob is pushed down onto it once. The shaft stops SEATER_SHORT short of the bore's blind end, so the
// knob's nose lands on the base (the base is the stop, not the shaft tip); a 0.6 mm fillet at its root, a chamfer at
// its tip as the real shaft's. Prints base down, the shaft upright: the round and the flat print true.
SEATER_BASE_D = 28; SEATER_BASE_H = 4.0; SEATER_SHORT = 0.3;
OVERLAP_Z = [-1, 40];                            // knob_seater_overlap: only this height band (the checks split it)
SEATER_L = KNOB_ENGAGE - SEATER_SHORT;           // shaft above the base
SEATER_STOP = 0.6 * (0.6 - (KNOB_BORE / 2 - SHAFT_D / 2)) / 0.6;   // the knob's nose lands on the root fillet this far up (0.4)
SEATER_SIT = (KNOB_BORE / 2 - (SHAFT_FLAT + KNOB_FLAT_CLR)) + (SHAFT_FLAT - SHAFT_D / 2);   /* the bore's flat (-1.34) less the shaft's (-1.5): +0.16 */   // in the bore, the leaf holds the
                                                                                         // shaft's flat on the rigid one: off-centre this much (y)
module knob_seater() {
    c = 0.6;                                                    // the base's edges, chamfered
    rotate_extrude($fn = 96) polygon([[0, 0], [SEATER_BASE_D / 2 - c, 0], [SEATER_BASE_D / 2, c],
        [SEATER_BASE_D / 2, SEATER_BASE_H - c], [SEATER_BASE_D / 2 - c, SEATER_BASE_H], [0, SEATER_BASE_H]]);
    // the shaft: one turned profile (root fillet, the round, the tip chamfer), its flat cut by one plane, as the EC11's
    translate([0, 0, SEATER_BASE_H - 0.5]) intersection() {
        rotate_extrude($fn = 64) polygon([[0, 0], [SHAFT_D / 2 + 0.6, 0], [SHAFT_D / 2 + 0.6, 0.5], [SHAFT_D / 2, 1.1],
            [SHAFT_D / 2, 0.5 + SEATER_L - 0.5], [SHAFT_D / 2 - 0.5, 0.5 + SEATER_L], [0, 0.5 + SEATER_L]]);
        translate([-SHAFT_D, -(SHAFT_FLAT - SHAFT_D / 2), -1]) cube([2 * SHAFT_D, 2 * SHAFT_D, SEATER_L + 3]);   // the flat on -y, as the bore's (knob_bore_plain) and the knob_section shaft's
    }
}

// LED standoff (2026-11-06): a tube under D1/D2 with a divider up its middle, a lead each side; the
// LED's flange sits on the divider and the rim. Only a spacer, so the leads are loose. The leads span 3.04 (0.5 square
// on 2.54), so the bore can't be under the lens's 3.0: bore 3.6, wall 0.6 -> 4.8, ends 2.4 from the LED's centre,
// 0.53 clear of R12/R13's lead (x 49.7). Was 6.8 long with two holes and hit that lead (check_fit missed it: the
// spacers weren't checked against the board's parts, now they are). Prints standing up.
LS_BORE = 3.6; LS_WALL = 0.6; LS_DIV = 0.6;
module led_standoff() {
    difference() { cylinder(d = LS_BORE + 2 * LS_WALL, h = LED_STANDOFF, $fn = 48);
                   translate([0, 0, -EPS]) cylinder(d = LS_BORE, h = LED_STANDOFF + 2 * EPS, $fn = 48); }
    translate([-LS_DIV / 2, -(LS_BORE / 2 + LS_WALL / 2), 0]) cube([LS_DIV, LS_BORE + LS_WALL, LED_STANDOFF]);
}

// One OLED pillar, as fitted: z 0 = the board's top face, local +x = outward, toward the module's side edge.
// Head: the module's PCB rests on the body's top (z = OLED_PILLAR_H) under an upper jaw, with the groove's
// bottom (the spine) GROOVE_CLR beyond its edge. The head is trimmed symmetric about the axis, |y| <= PILLAR_BED
// (the bed flat's distance), so all four are the same part (the left two turned round); the body is a full hex. Prints lying on its side (oled_pillars): the snap
// prongs are printed along their length (strong in bending) and nothing needs support.
PEG_FLAT = 0.3;                       // flat along the underside of the peg, for the bed
PILLAR_BED = PEG_D / 2 - PEG_FLAT;    // the bed plane (and the head's half-width), from the axis
BARB_L = 1.0; BARB_GAP = 0.1;         // barb length; board thickness + this before it catches
RELIEF = 2.0;                         // groove round the peg's root, up into the body: longer prongs flex less
SLOT_W = 0.8;                         // between the two prongs (>= 0.65: a slot that prints)
module pillar() {
    T = BOARD_T; R = PILLAR_AF / sqrt(3); H = OLED_PILLAR_H; X1 = GROOVE_X + SPINE;
    intersection() {   // the bed flat, for printing on its side
        union() {
            difference() {
                cylinder(r = R, h = H, $fn = 6);                                                // hex body, full
                translate([0, 0, -EPS]) cylinder(d = PEG_D + 0.8, h = RELIEF, $fn = 32);        // the relief groove
            }
            intersection() {   // head: symmetric about the axis (|y| <= PILLAR_BED), so the four are one part
                union() {
                    translate([0, -5, H - 2.5]) cube([X1, 10, 2.5]);                            // bracket out to the spine
                    translate([GROOVE_X, -5, H - EPS]) cube([SPINE, 10, OLED_SLOT + JAW_T + EPS]);   // spine
                    translate([JAW_IN, -5, H + OLED_SLOT]) cube([X1 - JAW_IN, 10, JAW_T]);           // upper jaw
                }
                translate([-10, -PILLAR_BED, H - 3]) cube([20, 2 * PILLAR_BED, 10]);
            }
            difference() {
                union() {
                    translate([0, 0, -T - BARB_GAP]) cylinder(d = PEG_D, h = T + BARB_GAP + RELIEF + EPS, $fn = 32);
                    intersection() {   // barb: a cone, trimmed to the two prongs' sides (+-x) so it passes the hole in y
                        translate([0, 0, -T - BARB_GAP - BARB_L]) cylinder(d1 = PEG_D - 0.5, d2 = BARB_D, h = BARB_L, $fn = 32);
                        translate([-5, -(OLED_BOARD_HOLE_D / 2 - 0.1), -10]) cube([10, OLED_BOARD_HOLE_D - 0.2, 10]);
                    }
                }
                translate([-SLOT_W / 2, -5, -T - BARB_GAP - BARB_L - 1]) cube([SLOT_W, 10, T + BARB_GAP + BARB_L + 1 + RELIEF - 0.4]);
            }
        }
        translate([-10, -PILLAR_BED, -10]) cube([20, 20, H + 20]);
    }
}

// ---- for renders only: the OLED as fitted (module spec WP013..L102B-01A [D]; header row 2.0 from
// its rear edge as the PCB assumes), on its spacers over J4. Board coords -> case via cx/cy.
module oled_fitted() {
    z0 = PCB_TOP + OLED_PILLAR_H;                 // module board's underside, on the pillars
    hx = OLED_X0 + OLED_W / 2;                    // header / module centre line
    for (h = OLED_HOLES)                          // pillars in H5-H8, each head (local +x) out over the module's side edge
        color("Gainsboro") translate([cx(h[0]), cy(h[1]), PCB_TOP]) rotate([0, 0, h[0] < OLED_HDR[0] ? 180 : 0]) pillar();
    color("#222222") translate([cx(hx) - 5.08, cy(OLED_Y0 + 2.0) - 1.27, PCB_TOP]) cube([10.16, 2.54, 8.5]);   // J4
    color("#1f5fa8") translate([cx(OLED_X0), cy(OLED_Y0 + OLED_D), z0]) cube([OLED_W, OLED_D, 1.0]);       // PCB
    color("#f0f0f0") translate([cx(OLED_X0 + 0.5), cy(OLED_Y0 + 5.25 + 23.0), z0 + 1.0]) cube([34.5, 23.0, 0.8]);  // foam
    color("#3a3a3a") translate([cx(OLED_X0 + 0.5), cy(OLED_Y0 + 5.25 + 23.0), z0 + 1.8]) cube([34.5, 23.0, 1.5]);  // glass
    translate([cx(hx), cy(OLED_Y0 + 7.35 + 7.35), z0 + 3.3]) {                                             // active area
        color("#050505") translate([-29.42 / 2, -14.7 / 2, 0]) cube([29.42, 14.7, 0.02]);
        color("#bfe8ff") translate([0, 2.6, 0.02]) linear_extrude(0.05)
            text("PicoD64", size = 3.6, halign = "center", valign = "center");
        color("#bfe8ff") translate([0, -3.4, 0.02]) linear_extrude(0.05)
            text("LOAD\"*\",8,1", size = 2.6, halign = "center", valign = "center");
    }
}

// ---- sanity checks on the Customizer values: fail here rather than print a part that cannot work ----
NAME_C = cx((IEC_X[0] + IEC_X[1]) / 2); NAME_W = label_w(NAME, NAME_SIZE);
assert(NAME_C - NAME_W / 2 - WALL >= 1.5, "NAME too long: it runs off the lid's left edge");
assert(cx(BUZZER[0]) - 4.5 - (NAME_C + NAME_W / 2) >= 1.5, "NAME too long: it runs into the speaker vents");
assert(ROOF - LABEL_DEEP >= 1.0, "labels cut too deep for the ROOF: leave >= 1.0 under them");
assert(WALL - LABEL_DEEP_CUT >= 1.0, "USB label cut too deep for the WALL");
assert(WALL - LAP_T >= 0.8, "WALL too thin for the side tongues (LAP_T 1.0)");
assert(SCREW_L - PCB_TOP >= 4, str("SCREW_L too short: only ", SCREW_L - PCB_TOP, " mm reaches the lid"));
assert(SCREW_L - PCB_TOP <= INSERT_H - 0.5, str("SCREW_L too long: ", SCREW_L - PCB_TOP, " mm into a ", INSERT_H, " mm hole"));
assert(min([for (h = HOLES) min(cx(h[0]), OUT_W - cx(h[0]), cy(h[1]), OUT_L - cy(h[1]))]) - FOOT_D / 2 >= 0.5,
       "FOOT_D too big: a foot would overhang the tray's edge");
assert(KNOB_H - (KNOB_ENGAGE - NOSE_H) >= LABEL_DEEP + 1.0, "KNOB_H too low: the bore reaches the logo");
assert(KNOB_LOGO == "none" || KNOB_D >= 16, "the knob logo needs KNOB_D >= 16");

// ---- the two lid parts print TOP DOWN (turned over about x), each its own top on the bed ----
module flip(top) translate([0, OUT_L, top]) rotate([180, 0, 0]) children();
if (part == "tray") tray();
else if (part == "lid_front") flip(FRONT_TOP) lid_front();
else if (part == "lid_rear") flip(REAR_TOP) lid_rear();
else if (part == "knob") translate([0, 0, KNOB_H]) rotate([180, 0, 0]) knob();   // top down: nose up
// inlay letters: each exactly fills its lid's cuts (export the lid with -D INLAY=true), in the lid's print position
else if (part == "labels_front") flip(FRONT_TOP) intersection() { lid_labels(wall = false); front_side();
       translate([-1, -1, FRONT_TOP - LABEL_DEEP - 1]) cube([OUT_W + 2, OUT_L + 2, 1 + LABEL_DEEP]); }
else if (part == "labels_rear") flip(REAR_TOP) intersection() { lid_labels(wall = false); rear_side();
       translate([-1, -1, REAR_TOP - LABEL_DEEP - 1]) cube([OUT_W + 2, OUT_L + 2, 1 + LABEL_DEEP]); }
else if (part == "knob_logo") translate([0, 0, KNOB_H]) rotate([180, 0, 0]) intersection() {
       translate([0, 0, KNOB_H]) vcut() logo_2d(KNOB_LOGO); cylinder(d = KNOB_D, h = KNOB_H, $fn = 72); }
else if (part == "badge_pwr") led_badge("PWR");   // letters up; the letters are a second colour from their first layer
else if (part == "badge_act") led_badge("ACT");
else if (part == "badge_name") badge();
else if (part == "badges_front_fit") badges_fit(front = true, rear = false);   // as fitted, for the renders
else if (part == "badges_rear_fit") badges_fit(front = false, rear = true);
else if (part == "letters_front_fit") badges_fit(true, true, false);
else if (part == "letters_rear_fit") badges_fit(true, false, true);
else if (part == "led_standoffs") for (i = [0 : 1]) translate([i * 8, 0, 0]) led_standoff();
else if (part == "knob_seater") knob_seater();      // base down, the shaft up
else if (part == "knob_seated")                     // for the renders: the knob as pushed onto the tool (its nose on the
       intersection() {                               // root fillet, SEATER_STOP up), cut through the leaf and the flat
           union() { color("#555") translate([0, SEATER_SIT, 0]) knob_seater(); color(KNOB_COLOUR) translate([0, 0, SEATER_BASE_H + SEATER_STOP + NOSE_H]) knob(); }
           translate([0, -30, -1]) cube([30, 60, 40]);
       }
else if (part == "knob_seater_overlap")              // check: what of the seated knob the tool's shaft is inside of (the leaf only)
       intersection() { translate([0, SEATER_SIT, 0]) knob_seater(); translate([0, 0, SEATER_BASE_H + SEATER_STOP + NOSE_H]) knob();
                        translate([-20, -20, OVERLAP_Z[0]]) cube([40, 40, OVERLAP_Z[1] - OVERLAP_Z[0]]); }
else if (part == "oled_pillars")   // four, on their sides: the flat on the bed, the axis along y
       for (i = [0 : 3]) translate([i * (PILLAR_AF + 4), 0, PILLAR_BED]) rotate([90, 0, 0]) pillar();
else if (part == "oled_pillar_fitted") pillar();
else if (part == "lid_front_raw") lid_front();
else if (part == "lid_rear_raw") lid_rear();     // as fitted, for render.sh
else if (part == "knob_raw") knob();              // as fitted (z 0 = its underside), for render.sh
else if (part == "knob_section")   // cut through the shaft, seen from the side: knob nose in the lid countersink
       intersection() {
           union() { color(LID_COLOUR) lid_front(); translate([cx(SHAFT_X), cy(SHAFT_Y), FRONT_TOP + KNOB_CLR]) color(KNOB_COLOUR) knob();
                     color("Goldenrod") translate([cx(SHAFT_X), cy(SHAFT_Y), PCB_TOP + SHAFT_FLAT_FROM]) intersection() {
                         cylinder(d = 6, h = SHAFT_TIP - SHAFT_FLAT_FROM, $fn = 32); translate([-3, -1.5, 0]) cube([6, 6, 20]); } }
           translate([cx(SHAFT_X) - 15, cy(SHAFT_Y), PCB_TOP + 10]) cube([30, 30, 30]);
       }
else if (part == "section") {   // for render.sh: cut through the right-hand OLED pillars, seen from the side
       sx = cx(OLED_X0 + OLED_W / 2 + 15.2);
       intersection() {
           union() {
               color(TRAY_COLOUR) tray(); color(LID_COLOUR) lid_front(); color(LID_REAR_COLOUR) lid_rear(); oled_fitted();
               color("#2e6b30") translate([WALL + CLR, WALL + CLR, PCB_BOT]) cube([BOARD_W, BOARD_L, BOARD_T]);   // the PCB
           }
           translate([sx - 200, -10, -10]) cube([200, OUT_L + 20, 60]);
       }
}
else if (part == "labels_2d") name_2d();     // for check_labels.sh
else if (part == "view") {
       color(TRAY_COLOUR) tray(); color(LID_COLOUR) lid_front(); color(LID_REAR_COLOUR) lid_rear();
       if (LABEL_OVERLAY) color("#1a1a1a") lid_labels(); oled_fitted();
       if (STYLE == "c64") { color(BADGE_COLOUR) badges_fit(); color(BADGE_INK) badges_fit(true); }
       for (l = [[LED_PWR, "#2fbf3a"], [LED_ACT, "#d42020"]])
           color(l[1]) translate([cx(l[0][0]), cy(l[0][1]), PCB_TOP + LED_STANDOFF]) {
               cylinder(d = 3.0, h = LED_LENS - 1.5, $fn = 32);
               translate([0, 0, LED_LENS - 1.5]) sphere(d = 3.0, $fn = 32);
           }
       translate([cx(SHAFT_X), cy(SHAFT_Y), FRONT_TOP + KNOB_CLR]) color(KNOB_COLOUR) knob(); }
else if (part == "exploded") {
       color(TRAY_COLOUR) tray(); translate([0, -12, 25]) color(LID_COLOUR) lid_front(); translate([0, 12, 25]) color(LID_REAR_COLOUR) lid_rear();
       if (STYLE == "c64") { translate([0, -12, 25]) { color(BADGE_COLOUR) badges_fit(rear = false); color(BADGE_INK) badges_fit(true, rear = false); }
                             translate([0, 12, 25]) { color(BADGE_COLOUR) badges_fit(front = false); color(BADGE_INK) badges_fit(true, front = false); } } }
else if (part == "none") ;   // for files that include this one
else { color("SlateGray") tray(); color("Gainsboro", 0.6) lid_front(); color("LightSteelBlue", 0.6) lid_rear();
       translate([cx(SHAFT_X), cy(SHAFT_Y), FRONT_TOP + KNOB_CLR]) color("DimGray") knob(); }
